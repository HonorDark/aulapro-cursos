# Desarrollo local. No reutilices estos valores en producción.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/aulaflow
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_64_O_MAS_CARACTERES
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=0

# Bootstrap inicial (solo cuando todavía no existe ningún SUPER_ADMIN activo).
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Integración de correo pendiente. Nunca se devuelve el token en producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AulaFlow <no-reply@example.com>
PASSWORD_RESET_PUBLIC_URL=http://localhost:5173/reset-password

# Almacenamiento privado pendiente para comprobantes y entregas.
STORAGE_DRIVER=database
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
