# Copia este archivo como docker.env y reemplaza todos los valores vacíos.
POSTGRES_DB=aulaflow
POSTGRES_USER=aulaflow
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=8h
TRUST_PROXY=1
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_WEB_PORT=8080
VITE_ENABLE_PRIVILEGED_DEMO=false

# false en producción. true carga cuentas y contenido de demostración conocidos.
AULAFLOW_LOAD_DEMO_DATA=false

# Solo se usan al ejecutar el bootstrap inicial.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
